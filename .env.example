# Pulled from Neon by `npx neon@latest env pull`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=

# Generate once and keep the same value in every Vercel environment.
# Example: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Dedicated test account for E2E / manual checks (isolated from your personal data by user_id)
# Use an email that contains "test" so seed/reset scripts refuse to touch real accounts.
TEST_ACCOUNT_EMAIL=test@munimuni.test
TEST_ACCOUNT_PASSWORD=MunimuniTest123!@#
TEST_ACCOUNT_NAME=Test Journal
